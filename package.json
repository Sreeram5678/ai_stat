{
  "name": "ai-stat",
  "version": "2.0.0",
  "description": "Local-first AI usage tracker and analytics Chrome extension (Manifest V3)",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node -e \"import fs from 'node:fs';const m=JSON.parse(fs.readFileSync('./manifest.json','utf8'));if(m.manifest_version!==3)process.exit(1);console.log('Manifest V3 valid');\"",
    "test": "npm run validate && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "ai-analytics",
    "chatgpt",
    "claude",
    "gemini",
    "deepseek",
    "perplexity",
    "privacy-first"
  ],
  "author": "Sreeram Lagisetty <sreeram.lagisetty@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sreeram5678/ai_stat.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
